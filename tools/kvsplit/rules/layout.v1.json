{
  "schemaVersion": 1,
  "repos": [
    { "id": "root",       "dir": ".",          "visibility": "public",  "property": "GkWorkflowRoot",  "preserve": ["LICENSE", "README.md", "AGENTS.md", "Keepverse.code-workspace", "tools/kvsplit/**", ".github/workflows/kvsplit.yml"] },
    { "id": "gk-core",    "dir": "gk-core",    "visibility": "public",  "property": "GkCoreRoot",     "preserve": ["LICENSE", "README.md"] },
    { "id": "gk-forge",   "dir": "gk-forge",   "visibility": "public",  "property": "GkForgeRoot",    "preserve": ["LICENSE", "README.md"] },
    { "id": "gk-web",     "dir": "gk-web",     "visibility": "public",  "property": "GkWebRoot",      "preserve": [".gitignore", "LICENSE", "README.md"] },
    { "id": "gk-tests",   "dir": "gk-tests",   "visibility": "public",  "property": "GkTestsRoot",    "preserve": [".gitignore", "AGENTS.md", "LICENSE", "README.md"] },
    { "id": "gk-fusion",  "dir": "gk-fusion",  "visibility": "public",  "property": "GkFusionRoot",   "preserve": ["LICENSE", "README.md"] },
    { "id": "gk-content", "dir": "gk-content", "visibility": "private", "property": "GkContentRoot",  "preserve": [".gitignore", "LICENSE", "README.md"] },
    { "id": "gk-data",    "dir": "gk-data",    "visibility": "private", "property": "GkDataRoot",     "preserve": [".gitignore", "LICENSE", "README.md"] },
    { "id": "gk-assets",  "dir": "gk-assets",  "visibility": "public",  "property": "GkAssetsRoot",   "preserve": [
        ".gitignore", "LICENSE", "LICENSE-CODE", "NOTICE.md", "README.md", "requirements.txt",
        ".agents/skills/**",
        "tools/blender_path.py", "tools/build.py", "tools/doctor.py", "tools/review.py",
        "tools/review_ui.py", "tools/viewer.html",
        "vfx/shield_ice_idle/FIX-REPORT.md", "vfx/shield_ice_idle/REVIEW-PACKET.md"
      ] }
  ],
  "compileDeps": {
    "gk-forge": ["gk-core"],
    "gk-fusion": ["gk-core"]
  },
  "unityRepos": ["gk-fusion"]
}
