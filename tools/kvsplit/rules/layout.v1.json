{
  "schemaVersion": 1,
  "repos": [
    {
      "id": "root",
      "dir": ".",
      "visibility": "public",
      "property": "GkWorkflowRoot",
      "preserve": [
        ".gitignore",
        "LICENSE",
        "README.md",
        "AGENTS.md",
        "Keepverse.code-workspace",
        "tools/kvsplit/**",
        ".github/workflows/kvsplit.yml",
        "docs/keepverse-migration-plan.md",
        "docs/migration-goal-prompt.md",
        "docs/migration-lane-setup.md",
        "docs/migration-state-measured.md",
        "docs/migration-*.md"
      ]
    },
    {
      "id": "gk-core",
      "dir": "gk-core",
      "visibility": "public",
      "property": "GkCoreRoot",
      "preserve": [
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-forge",
      "dir": "gk-forge",
      "visibility": "public",
      "property": "GkForgeRoot",
      "preserve": [
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-web",
      "dir": "gk-web",
      "visibility": "public",
      "property": "GkWebRoot",
      "preserve": [
        ".gitignore",
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-tests",
      "dir": "gk-tests",
      "visibility": "public",
      "property": "GkTestsRoot",
      "seal": {
        "reason": "gk-tests holds cross-repo test suites and nothing else. Shared gate definitions, shared harness logic and workspace policy are gk-workflow's single source of truth, and a second copy of one inside a sub-repository is a competing copy. Nothing in the legacy monorepo is a cross-repo suite, because before the split there were no repositories to span, so the split places nothing here - and this seal is what makes that a stated rule rather than an accident of no pattern matching. The one exception is a CI file a platform requires inside a sub-repository: it stays a thin entrypoint to workflow-owned policy, so a rule that wants to put one here must set 'entrypoint': true and carry its own reason."
      },
      "preserve": [
        ".gitignore",
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-fusion",
      "dir": "gk-fusion",
      "visibility": "public",
      "property": "GkFusionRoot",
      "preserve": [
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-content",
      "dir": "gk-content",
      "visibility": "private",
      "property": "GkContentRoot",
      "preserve": [
        ".gitignore",
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-data",
      "dir": "gk-data",
      "visibility": "private",
      "property": "GkDataRoot",
      "preserve": [
        ".gitignore",
        "LICENSE",
        "README.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "gk-assets",
      "dir": "gk-assets",
      "visibility": "public",
      "property": "GkAssetsRoot",
      "preserve": [
        ".gitignore",
        "LICENSE",
        "LICENSE-CODE",
        "NOTICE.md",
        "README.md",
        "AGENTS.md",
        "requirements.txt",
        ".agents/skills/**",
        "tools/blender_path.py",
        "tools/build.py",
        "tools/doctor.py",
        "tools/review.py",
        "tools/review_ui.py",
        "tools/viewer.html",
        "vfx/shield_ice_idle/FIX-REPORT.md",
        "vfx/shield_ice_idle/REVIEW-PACKET.md"
      ]
    }
  ],
  "compileDeps": {
    "gk-forge": [
      "gk-core"
    ],
    "gk-fusion": [
      "gk-core"
    ]
  },
  "testProjectGlobs": [
    "tests/**/*.Tests.csproj",
    "tests/**/*.Test.csproj",
    "src/**/*.Tests.csproj"
  ],
  "unityRepos": [
    "gk-fusion"
  ]
}
