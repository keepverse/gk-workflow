{
  "schemaVersion": 1,
  "extensions": [".cs", ".ps1", ".psm1", ".py", ".ts", ".tsx", ".js", ".mjs", ".cjs", ".json", ".yml", ".yaml", ".toml", ".sh", ".cmd", ".bat"],
  "pathRoots": ["src", "tests", "tools", "data", "docs", "web", "scripts", "content", "tasks"],
  "skip": ["tasks/sessions/**"],
  "citationGlobs": ["data/**", "content/**", "docs/**"],
  "packRoots": { "gk-data": "packs/fusion/" },
  "resolvers": {
    "gk-data": "content_root\\(|ContentRoot\\.|Get-ContentRoot",
    "gk-core": "core_root\\(|CoreRoot\\.|Get-CoreRoot",
    "root": "workspace_root\\(|WorkspaceRoot\\.|Get-WorkspaceRoot"
  },
  "outputRelativeGlobs": ["src/FusionRpg.Core/**", "src/FusionRpg.Data/**", "src/FusionRpg.Server/**"],
  "tokens": [],
  "accept": []
}
